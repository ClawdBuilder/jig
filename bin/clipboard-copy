#!/usr/bin/env bash
# Copies stdin to the system clipboard. tmux runs it when a mouse selection ends (copy on select).
# On WSL it feeds Windows' clip.exe UTF-16LE, which is what keeps non-ASCII text intact.
set -u
if grep -qi microsoft /proc/version 2>/dev/null && command -v clip.exe >/dev/null; then
    iconv -f UTF-8 -t UTF-16LE | clip.exe
elif [ -n "${WAYLAND_DISPLAY:-}" ] && command -v wl-copy >/dev/null; then
    wl-copy
elif command -v xclip >/dev/null; then
    xclip -selection clipboard
elif command -v pbcopy >/dev/null; then
    pbcopy
else
    cat >/dev/null
fi
