{
    "name": "@clawdbuilder/jig",
    "version": "0.4.1",
    "description": "One tool manager and a set of plugins for the Pi coding agent: permissions per tool and environment, approvals, secrets and records.",
    "repository": "git+https://github.com/ClawdBuilder/jig.git",
    "type": "module",
    "license": "MIT",
    "engines": {
        "node": ">=22.19.0"
    },
    "keywords": [
        "pi-package"
    ],
    "scripts": {
        "test": "node --import ./test/support/host.mjs --test \"test/*.test.ts\" \"plugins/*/test/*.test.ts\" \"examples/*/test/*.test.ts\" \"herdr/test/*.test.ts\"",
        "test:it": "node --import ./test/support/host.mjs --test \"plugins/*/test/it/*.test.ts\"",
        "check": "node test/support/link-host.mjs && node scripts/check-pinned-deps.mjs && node scripts/check-runtime-deps.mjs && tsc -p tsconfig.json && biome ci .",
        "check:install": "node scripts/check-install.mjs",
        "format": "biome format --write .",
        "lint": "biome lint .",
        "check:web": "npm --prefix plugins/jig-review/web run check",
        "test:web": "npm --prefix plugins/jig-review/web test",
        "check:dist": "node test/support/check-web-dist.mjs"
    },
    "dependencies": {
        "@anthropic-ai/sandbox-runtime": "0.0.81",
        "@hono/node-server": "2.1.5",
        "hono": "4.13.14",
        "ignore": "7.0.14",
        "mongodb": "7.8.0",
        "socks": "2.8.10",
        "yaml": "2.9.1"
    },
    "peerDependencies": {
        "@earendil-works/pi-ai": "*",
        "@earendil-works/pi-coding-agent": "*",
        "@earendil-works/pi-tui": "*",
        "typebox": "*"
    },
    "pi": {
        "extensions": [
            "./plugins/jig-core/index.ts",
            "./plugins/jig-sandbox/index.ts",
            "./plugins/jig-memory/index.ts",
            "./plugins/jig-workflow/index.ts",
            "./plugins/jig-agents/index.ts",
            "./plugins/jig-git/index.ts",
            "./plugins/jig-lens/index.ts",
            "./plugins/jig-jira/index.ts",
            "./plugins/jig-logs/index.ts",
            "./plugins/jig-api/index.ts",
            "./plugins/jig-ops/index.ts",
            "./plugins/jig-review/index.ts",
            "./plugins/jig-mongo/index.ts",
            "./plugins/jig-session/index.ts",
            "./plugins/jig-theme/index.ts"
        ],
        "skills": [
            "./plugins/*/skills"
        ],
        "themes": [
            "./plugins/jig-theme/themes/*.json"
        ]
    },
    "devDependencies": {
        "@biomejs/biome": "2.6.4",
        "typescript": "7.0.2",
        "@earendil-works/pi-ai": "1.5.0",
        "@earendil-works/pi-coding-agent": "1.5.0",
        "@earendil-works/pi-tui": "1.5.0",
        "typebox": "1.3.27"
    },
    "bin": {
        "jig": "./bin/jig.mjs"
    },
    "peerDependenciesMeta": {
        "@earendil-works/pi-ai": {
            "optional": true
        },
        "@earendil-works/pi-coding-agent": {
            "optional": true
        },
        "@earendil-works/pi-tui": {
            "optional": true
        },
        "typebox": {
            "optional": true
        }
    },
    "publishConfig": {
        "access": "public"
    },
    "files": [
        "bin/",
        "plugins/*/index.ts",
        "plugins/*/src/",
        "plugins/*/package.json",
        "plugins/*/skills/",
        "plugins/*/themes/",
        "plugins/jig-review/web/dist/",
        "plugins/jig-lens/web/",
        "docs/",
        "README.md",
        "CHANGELOG.md",
        "LICENSE"
    ]
}
